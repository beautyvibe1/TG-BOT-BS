# ═══════════════════════════════════════════════════════════════════
#  Beauty Supply MSK — Telegram-экосистема
#  Скопируйте этот файл в `.env` и заполните реальными значениями.
#  НИКОГДА не коммитьте `.env` в репозиторий.
# ═══════════════════════════════════════════════════════════════════

# ─── Telegram ───────────────────────────────────────────────────────
BOT_TOKEN=TOKEN-X
# Канал, в который автопостится каталог
# (числовой ID канала; бот сам приведёт его к отрицательному виду)
CHANNEL_ID=1003907669991
CHANNEL_URL=https://t.me/beautysupplymsk
# Список Telegram user_id администраторов (json-массив)
ADMIN_IDS=[8519523671,8748403400]
# ID группы, куда пересылаются заявки/консультации (число, с минусом)
MANAGER_GROUP_ID=-5512850056

# ─── Website ────────────────────────────────────────────────────────
SITE_URL=https://beautysupplymsk.github.io/new/
SITE_CATALOG_URL=https://beautysupplymsk.github.io/new/#catalog
SITE_REPO_URL=https://github.com/BEAUTYSUPPLYMSK/new
AVITO_URL=https://www.avito.ru/user/7d5cc17e554a6f4d901ec51bdd907f7b/profile
INSTAGRAM_URL=https://instagram.com/beautysupplymsk
SUPPORT_EMAIL=support@beauty-supply.shop
BOT_USERNAME=BEAUTYSUPPLYMSKBOT
# Имя бота, которое используется для deep-link'ов
# BOT_USERNAME=@your_bot_username

# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# DATABASE_URL=postgresql+asyncpg://beauty:beauty@db:5432/beauty_bot

# ─── Redis ──────────────────────────────────────────────────────────
# Используется для FSM storage и кэша. Можно отключить.
REDIS_URL=redis://localhost:6379/0
# Если Redis недоступен — использовать in-memory storage
USE_REDIS=true

# ─── Payments ───────────────────────────────────────────────────────
# Telegram provider token (от @BotFather -> Payments)
PAYMENT_PROVIDER_TOKEN=your_telegram_payment_provider_token
# ЮKassa (YooKassa) — российские карты
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
# Валюта платежей (RUB / XTR для Telegram Stars)
PAYMENT_CURRENCY=RUB
# Включить реальные платежи (false — эмуляция для разработки)
PAYMENTS_ENABLED=false

# ─── Telegram Mini App (WebApp) ─────────────────────────────────────
# URL, под которым размещён webapp (GitHub Pages / статика)
WEBAPP_URL=https://beautyvibe1.github.io/TG-BOT-BS/webapp/
# Секрет для подписи initData (равен BOT_TOKEN по умолчанию)
# WEBAPP_SECRET=

# ─── Channel autoposting (scheduler) ────────────────────────────────
CHANNEL_POSTING_ENABLED=true
# Часы публикаций (каждое время рандомизируется ±15 мин)
CHANNEL_POST_TIMES=["09:00","14:00","19:00"]
# Таймзона планировщика
TIMEZONE=Europe/Moscow

# ─── Settings ───────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
# polling — для разработки, webhook — для продакшена
BOT_MODE=polling
# Адрес и путь вебхука (для BOT_MODE=webhook)
WEBHOOK_URL=https://example.com/webhook
WEBHOOK_PATH=/webhook
WEBHOOK_PORT=8080
WEBAPP_HOST=0.0.0.0
